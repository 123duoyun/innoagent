# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Vite frontend env (prefixed with VITE_ to be exposed to browser)
VITE_API_BASE=""
VITE_INNO_AGENT_API_PROXY_TARGET="http://localhost:3001"
VITE_INNO_AGENT_WORKSPACE_URL_TEMPLATE=""

# Zitadel auth backend configuration
ZITADEL_ISSUER=http://auth.localhost
ZITADEL_CLIENT_ID=375888989380476932
ZITADEL_LOGIN_REDIRECT_URI=http://localhost:3001/auth/callback
ZITADEL_SERVICE_PAT=<your-zitadel-service-account-pat>
AUTH_BACKEND_PORT=3001
