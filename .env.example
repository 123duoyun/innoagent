# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Vite frontend env (prefixed with VITE_ to be exposed to browser)
VITE_API_BASE=""
VITE_INNO_AGENT_API_PROXY_TARGET="http://localhost:3000"
VITE_INNO_AGENT_WORKSPACE_URL_TEMPLATE="http://www.innoagent.tech/sandbox/{sandboxId}"

# ─── Zitadel OIDC 配置 ───────────────────────────────────────────────────────
ZITADEL_ISSUER=http://inno.localhost
ZITADEL_INTERNAL_ISSUER=http://inno.localhost
ZITADEL_CLIENT_ID=
ZITADEL_LOGIN_REDIRECT_URI=http://auth-service:3000/auth/callback
AUTH_BACKEND_PORT=3000
DISABLE_HMR=false
ZITADEL_PROJECT_ID=
ZITADEL_DEFAULT_ROLE_KEY=

# ─── 阿里云短信配置 ─────────────────────────────────────────────────────────
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
