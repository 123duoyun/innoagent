{
  "name": "inno-agent",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter inno-agent-frontend dev",
    "dev:server": "cd auth-backend && npx tsx watch src/index.ts",
    "dev:all": "npx concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "build": "pnpm -r run build",
    "lint": "pnpm --filter inno-agent-frontend lint",
    "clean": "rm -rf inno-agent-frontend/dist auth-backend/dist"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
